<% layout("/layouts/boilerplate")%>
<link rel="stylesheet" href="/style/index.css">
<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-couch"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></i></div>
    <p>Historic Places</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tent"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-skiing"></i></div>
    <p>Ski's In</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-chess-rook"></i></div>
    <p>Castle</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-panorama"></i></div>
    <p>Scenic Place</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Artic</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mosque"></i></div>
    <p>Wanders</p>
  </div>
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Include Taxes</label>
    </div>
  </div>
</div>
  
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <%for(let listing of allListings){%>
    <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <div class="card-img-overlay"></div>
      <img src="<%=listing.image.url %>" class="card-img-top" alt="Listing_Image" style="height: 20rem;">
      <div class="card-body">
      <p class="card-text">
        <b><%=listing.title%></b>
        <br>
        &#8377;<%=listing.price.toLocaleString("en-IN")%> / night
        <i  class="tax-info"> &nbsp; &nbsp; +18% GST</i>
      </p>
      </div>
    </div>
    </a>
  <%}%>
</div>
<script src="/js/taxes.js"></script>